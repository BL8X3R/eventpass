# Variables PÚBLICAS del frontend. Se copian a dist/config.js en el build.
# No pongas aquí tokens ni contraseñas: todo lo secreto vive en las credenciales de n8n.

# URL pública de n8n (túnel ngrok o dominio), sin barra final.
N8N_BASE_URL=https://tu-dominio.ngrok-free.app

# URL del Chat Trigger de WF10 (se copia desde el nodo "Chat Trigger" en n8n).
N8N_CHAT_URL=https://tu-dominio.ngrok-free.app/webhook/xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx/chat

# Usuario del bot de Telegram, sin @. Se usa para el enlace t.me/<bot>.
TELEGRAM_BOT_USERNAME=EventPassBot
