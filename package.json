{
  "name": "eventpass",
  "version": "1.0.0",
  "private": true,
  "description": "EventPass: catálogo e inscripción a eventos tech con toda la lógica en n8n.",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/build.mjs && npx --yes serve@14.2.4 dist -l 3000",
